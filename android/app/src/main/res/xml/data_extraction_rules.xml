<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+): cloud backup and device-to-device transfer are separate.
  allowBackup="false" alone does not block D2D transfer of app data on all devices.
  Exclude storage domains that hold AsyncStorage (deviceId and other local keys).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
